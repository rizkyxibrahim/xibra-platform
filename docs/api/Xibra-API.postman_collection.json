                  "pm.test(\"code is VALIDATION_ERROR\", () => pm.expect(res.code).to.eql(\"VALIDATION_ERROR\"));",
                  "pm.test(\"owner role is explicitly rejected\", () => pm.expect(res.meta.errors.role).to.include(\"The owner role cannot be assigned through an invitation.\"));"
                ]
              }
            }
          ]
        },

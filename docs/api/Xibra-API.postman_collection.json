  "item": [
    {
      "name": "01 Health",
      "item": [
        {
          "name": "GET /api/v1/health",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/v1/health",
            "description": "Public liveness probe. Expects HTTP 200 with code HEALTHY."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "",
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"envelope: success is true\", () => pm.expect(res.success).to.eql(true));",
                  "pm.test(\"code is HEALTHY\", () => pm.expect(res.code).to.eql(\"HEALTHY\"));",
                  "pm.test(\"envelope has all five keys\", () => {",
                  "    [\"success\", \"message\", \"code\", \"data\", \"meta\"].forEach(k => pm.expect(res).to.have.property(k));",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 Auth",
      "item": [
        {
          "name": "POST /api/v1/auth/login (owner)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"{{owner_username}}\",\n  \"password\": \"{{owner_password}}\",\n  \"device_name\": \"{{device_name}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/api/v1/auth/login",
            "description": "Authenticate with any of the three identifiers (username, email, phone) in the `identifier` field. On success, captures `data.token` into the `access_token` collection variable. Rate limited: 5/min per identifier, 20/min per IP."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "",
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"envelope: success is true\", () => pm.expect(res.success).to.eql(true));",
                  "pm.test(\"code is AUTHENTICATED\", () => pm.expect(res.code).to.eql(\"AUTHENTICATED\"));",
                  "pm.test(\"token is returned\", () => pm.expect(res.data.token).to.be.a(\"string\").and.not.empty);",
                  "pm.test(\"owner role is present\", () => pm.expect(res.data.user.roles.map(r => r.name)).to.include(\"owner\"));",
                  "pm.test(\"no password material in the user payload\", () => pm.expect(res.data.user).to.not.have.property(\"password\"));",
                  "",
                  "pm.collectionVariables.set(\"access_token\", res.data.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /api/v1/auth/me",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/v1/auth/me",
            "description": "The authenticated identity, resolved from the bearer token only. Expects HTTP 200 with code USER_RETRIEVED."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "",
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"code is USER_RETRIEVED\", () => pm.expect(res.code).to.eql(\"USER_RETRIEVED\"));",
                  "pm.test(\"identity matches the login identifier\", () => pm.expect(res.data.username).to.eql(pm.collectionVariables.get(\"owner_username\")));",
                  "pm.test(\"roles are exposed\", () => pm.expect(res.data.roles).to.be.an(\"array\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/v1/auth/logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/v1/auth/logout",
            "description": "Revokes the token used for the request. Expects HTTP 200 with code LOGGED_OUT."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "",
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"code is LOGGED_OUT\", () => pm.expect(res.code).to.eql(\"LOGGED_OUT\"));",
                  "pm.test(\"data is null\", () => pm.expect(res.data).to.eql(null));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /api/v1/auth/me (revoked token)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/v1/auth/me",
            "description": "Repeats /auth/me with the token revoked by the previous request. Expects HTTP 401 with code UNAUTHENTICATED — proof that logout really revoked the token."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "",
                  "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"envelope: success is false\", () => pm.expect(res.success).to.eql(false));",
                  "pm.test(\"code is UNAUTHENTICATED\", () => pm.expect(res.code).to.eql(\"UNAUTHENTICATED\"));",
                  "pm.test(\"data is null\", () => pm.expect(res.data).to.eql(null));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/v1/auth/login (again, restore session)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"{{owner_username}}\",\n  \"password\": \"{{owner_password}}\",\n  \"device_name\": \"{{device_name}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/api/v1/auth/login",
            "description": "Logs in again so the later folders have a valid bearer token. Captures a fresh access_token."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "",
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"code is AUTHENTICATED\", () => pm.expect(res.code).to.eql(\"AUTHENTICATED\"));",
                  "",
                  "pm.collectionVariables.set(\"access_token\", res.data.token);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03 Invitations (Owner only)",
      "item": [
        {
          "name": "GET /api/v1/invitations (list)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/v1/invitations?page=1&per_page=15",
            "description": "Paginated invitation listing, newest first. Requires the `invitations.manage` permission (owner role). Pagination metadata lives in `meta` per docs §10: current_page, per_page, total, last_page. `per_page` max is 100."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "",
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"code is INVITATIONS_RETRIEVED\", () => pm.expect(res.code).to.eql(\"INVITATIONS_RETRIEVED\"));",
                  "pm.test(\"data is an array\", () => pm.expect(res.data).to.be.an(\"array\"));",
                  "pm.test(\"pagination meta is present\", () => {",
                  "    pm.expect(res.meta).to.be.an(\"object\");",
                  "    [\"current_page\", \"per_page\", \"total\", \"last_page\"].forEach(k => pm.expect(res.meta).to.have.property(k));",
                  "});",
                  "pm.test(\"stored hashes are never exposed\", () => {",
                  "    if (res.data.length > 0) {",
                  "        pm.expect(res.data[0]).to.not.have.property(\"code_hash\");",
                  "        pm.expect(res.data[0]).to.not.have.property(\"token_hash\");",
                  "    }",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/v1/invitations (create)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"expires_in_hours\": 24,\n  \"note\": \"Created via Postman\",\n  \"role\": \"member\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/api/v1/invitations",
            "description": "Creates an invitation and returns its one-time secrets. `expires_in_hours` is optional (default 24, bounds 1–72), `role` is optional (default member, `owner` is rejected), `note` is optional (max 1000 chars). The code and token in `data.secrets` are the only copies that will ever exist — the database stores hashes. Each run of this request creates a real invitation; the run revokes it later in this folder."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "",
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"code is INVITATION_CREATED\", () => pm.expect(res.code).to.eql(\"INVITATION_CREATED\"));",
                  "pm.test(\"invitation is pending with the member role\", () => {",
                  "    pm.expect(res.data.invitation.status).to.eql(\"pending\");",
                  "    pm.expect(res.data.invitation.role.name).to.eql(\"member\");",
                  "});",
                  "pm.test(\"one-time code has the documented format\", () => {",
                  "    pm.expect(res.data.secrets.code).to.match(/^XIBRA-[23456789ABCDEFGHJKMNPQRSTUVWXYZ]{4}-[23456789ABCDEFGHJKMNPQRSTUVWXYZ]{4}$/);",
                  "    pm.expect(res.data.secrets.token).to.have.lengthOf(48);",
                  "});",
                  "pm.test(\"no secret hashes in the invitation payload\", () => {",
                  "    pm.expect(res.data.invitation).to.not.have.property(\"code_hash\");",
                  "    pm.expect(res.data.invitation).to.not.have.property(\"token_hash\");",
                  "});",
                  "",
                  "pm.collectionVariables.set(\"invitation_id\", res.data.invitation.id);",
                  "pm.collectionVariables.set(\"invitation_code\", res.data.secrets.code);",
                  "pm.collectionVariables.set(\"invitation_token\", res.data.secrets.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /api/v1/invitations/{id}",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/v1/invitations/{{invitation_id}}",
            "description": "Single invitation. The `status` is the effective one: an overdue pending invitation reports `expired` even before the hourly sweeper materialises it. Unknown ids are concealed with a 404."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "",
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"code is INVITATION_RETRIEVED\", () => pm.expect(res.code).to.eql(\"INVITATION_RETRIEVED\"));",
                  "pm.test(\"returns the created invitation\", () => pm.expect(res.data.id).to.eql(Number(pm.collectionVariables.get(\"invitation_id\"))));",
                  "pm.test(\"no secret hashes in payload\", () => {",
                  "    pm.expect(res.data).to.not.have.property(\"code_hash\");",
                  "    pm.expect(res.data).to.not.have.property(\"token_hash\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/v1/invitations/{id}/revoke",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/v1/invitations/{{invitation_id}}/revoke",
            "description": "Revokes an unused (pending) invitation. Revoked invitations can never be redeemed. Expects HTTP 200 with code INVITATION_REVOKED."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "",
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"code is INVITATION_REVOKED\", () => pm.expect(res.code).to.eql(\"INVITATION_REVOKED\"));",
                  "pm.test(\"status is revoked with a revoker recorded\", () => {",
                  "    pm.expect(res.data.status).to.eql(\"revoked\");",
                  "    pm.expect(res.data.revoked_by).to.be.an(\"object\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/v1/invitations/{id}/revoke (conflict)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/v1/invitations/{{invitation_id}}/revoke",
            "description": "Repeats the revoke on the now-revoked invitation. Only pending invitations can be revoked: expects HTTP 409 with code INVITATION_NOT_REVOKABLE."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "",
                  "pm.test(\"HTTP 409\", () => pm.response.to.have.status(409));",
                  "pm.test(\"envelope: success is false\", () => pm.expect(res.success).to.eql(false));",
                  "pm.test(\"code is INVITATION_NOT_REVOKABLE\", () => pm.expect(res.code).to.eql(\"INVITATION_NOT_REVOKABLE\"));",
                  "pm.test(\"data and meta are null\", () => {",
                  "    pm.expect(res.data).to.eql(null);",
                  "    pm.expect(res.meta).to.eql(null);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "04 Onboarding (public)",
      "item": [
        {
          "name": "POST /api/v1/invitations (create onboarding invitation)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"expires_in_hours\": 24,\n  \"note\": \"Created via Postman onboarding\",\n  \"role\": \"member\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/api/v1/invitations",
            "description": "Creates a dedicated pending invitation for the onboarding flow and captures its one-time code. Uses the Owner token from the Auth folder."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "",
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"code is INVITATION_CREATED\", () => pm.expect(res.code).to.eql(\"INVITATION_CREATED\"));",
                  "pm.test(\"invitation is pending with the member role\", () => {",
                  "    pm.expect(res.data.invitation.status).to.eql(\"pending\");",
                  "    pm.expect(res.data.invitation.role.name).to.eql(\"member\");",
                  "});",
                  "",
                  "pm.collectionVariables.set(\"onboarding_invitation_code\", res.data.secrets.code);"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/v1/invitations/redeem (public)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"secret\": \"{{onboarding_invitation_code}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/api/v1/invitations/redeem",
            "description": "Validates the invitation code and opens a short-lived (15 minute, single-use) onboarding session. Returns the raw session token exactly once; the database stores only its hash. Expects HTTP 201 with code ONBOARDING_SESSION_CREATED."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "",
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"code is ONBOARDING_SESSION_CREATED\", () => pm.expect(res.code).to.eql(\"ONBOARDING_SESSION_CREATED\"));",
                  "pm.test(\"session token is 48 characters\", () => pm.expect(res.data.session_token).to.have.lengthOf(48));",
                  "pm.test(\"role and invitation expiry are exposed, internals are not\", () => {",
                  "    pm.expect(res.data.invitation.role.name).to.eql(\"member\");",
                  "    pm.expect(res.data.invitation).to.not.have.property(\"id\");",
                  "    pm.expect(res.data.invitation).to.not.have.property(\"note\");",
                  "});",
                  "",
                  "pm.collectionVariables.set(\"onboarding_session_token\", res.data.session_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/v1/onboarding/complete (public)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"session_token\": \"{{onboarding_session_token}}\",\n  \"name\": \"Postman Onboarding Member\",\n  \"username\": \"{{onboarding_username}}\",\n  \"email\": \"{{onboarding_email}}\",\n  \"password\": \"{{onboarding_password}}\",\n  \"device_name\": \"postman-onboarding\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/api/v1/onboarding/complete",
            "description": "Validates the single-use onboarding session and identity, creates an active Member account, marks the invitation redeemed, consumes every session for it, and returns the first Sanctum token. The username and email are made unique per run. Expects HTTP 201 with code ACCOUNT_CREATED. NOTE: this creates a real account."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const suffix = Date.now().toString(36);",
                  "pm.collectionVariables.set(\"onboarding_username\", \"member_\" + suffix);",
                  "pm.collectionVariables.set(\"onboarding_email\", \"member_\" + suffix + \"@example.test\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "",
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"code is ACCOUNT_CREATED\", () => pm.expect(res.code).to.eql(\"ACCOUNT_CREATED\"));",
                  "pm.test(\"account is active with the member role\", () => {",
                  "    pm.expect(res.data.user.is_active).to.eql(true);",
                  "    pm.expect(res.data.user.roles[0].name).to.eql(\"member\");",
                  "    pm.expect(res.data.user.username).to.eql(pm.collectionVariables.get(\"onboarding_username\"));",
                  "});",
                  "pm.test(\"a Sanctum token is returned\", () => pm.expect(res.data.token).to.be.a(\"string\").and.not.empty);",
                  "",
                  "pm.collectionVariables.set(\"onboarding_member_token\", res.data.token);",
                  "pm.collectionVariables.set(\"member_access_token\", res.data.token);"
                ]
              }
            }
          ]
        },

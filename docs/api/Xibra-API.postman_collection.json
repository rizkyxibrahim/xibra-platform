    {
      "name": "05 Error and security checks",
      "item": [
        {
          "name": "GET /api/v1/invitations (guest)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/v1/invitations",
            "description": "Invitation endpoints without a token. Expects HTTP 401 with code UNAUTHENTICATED."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "",
                  "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"code is UNAUTHENTICATED\", () => pm.expect(res.code).to.eql(\"UNAUTHENTICATED\"));",
                  "pm.test(\"data is null\", () => pm.expect(res.data).to.eql(null));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /api/v1/invitations (member, forbidden)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{member_access_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/v1/invitations",
            "description": "Authorization boundary: a valid Member token must receive HTTP 403 with code FORBIDDEN. The token is captured by the Onboarding folder; if that folder was skipped, the variable is empty and this falls back to asserting 401 UNAUTHENTICATED."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "const memberToken = pm.collectionVariables.get(\"member_access_token\");",
                  "",
                  "if (memberToken) {",
                  "    pm.test(\"HTTP 403 FORBIDDEN for members\", () => {",
                  "        pm.response.to.have.status(403);",
                  "        pm.expect(res.code).to.eql(\"FORBIDDEN\");",
                  "    });",
                  "} else {",
                  "    pm.test(\"no member token configured yet (expected 401)\", () => {",
                  "        pm.response.to.have.status(401);",
                  "        pm.expect(res.code).to.eql(\"UNAUTHENTICATED\");",
                  "    });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /api/v1/invitations/999999 (concealed)",

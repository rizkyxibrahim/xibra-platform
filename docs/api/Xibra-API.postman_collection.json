        {
          "name": "POST /api/v1/invitations (owner role rejected)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"owner\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{base_url}}/api/v1/invitations",
            "description": "Invitations can never assign the owner role — the owner account is exclusively provisioned by the bootstrap seeder. Expects HTTP 422 with a specific message in meta.errors.role, and no invitation is created."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "",

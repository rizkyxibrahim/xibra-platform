{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["CLAUDE.md"],
  "permission": {
    "edit": "deny",
    "external_directory": "deny",
    "bash": {
      "*": "deny",
      "git status*": "allow",
      "git log*": "allow",
      "git diff*": "allow",
      "git branch*": "allow",
      "git remote -v": "allow",
      "git show*": "allow",
      "git rev-parse*": "allow",
    },
  },
}
